{
  "name": "@seanmozeik/aicommit",
  "version": "0.4.0",
  "description": "AI Commit Message Generator",
  "keywords": [
    "ai",
    "bun",
    "cli",
    "commit",
    "conventional-commits",
    "git"
  ],
  "homepage": "https://github.com/seanmozeik/AICommit#readme",
  "bugs": {
    "url": "https://github.com/seanmozeik/AICommit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanmozeik/AICommit.git"
  },
  "bin": {
    "aic": "./dist/aic.js"
  },
  "files": [
    "dist/aic.js"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun run format && bun run lint:fix && bun run typecheck",
    "dev": "bun run src/cli.ts",
    "prepublishOnly": "bun scripts/build.ts -- --no-formula",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --format agent --tsconfig tsconfig.oxlint.json ./src ./tests ./scripts",
    "lint:fix": "oxlint --format agent --tsconfig tsconfig.oxlint.json --fix ./src ./tests ./scripts",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@effect/ai-openai-compat": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "boxen": "^8.0.1",
    "effect": "4.0.0-rc.112",
    "gpt-tokenizer": "^4.0.0",
    "gradient-string": "^3.0.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.38.0",
    "@seanmozeik/de-clank": "0.1.7",
    "@types/gradient-string": "^1.1.6",
    "bun-types": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
