# Example .aic configuration file
# Project-local release flow and AI diff filtering for aic.

[ignore]
# Files or globs to omit from AI diff context.
# Useful for generated files, build artifacts, vendored code, snapshots, or
# project files that are always noisy and never useful for commit messages.
dist/**
artifacts/**
generated/**

[release]
# Commands run during `aic release` after the version bump and before commit/tag.
bun run build

[publish]
# Commands for project-specific publishing flows.
# npm publish
# VERSION=$(bun -p 'require("./package.json").version') && gh release create "v${VERSION}" artifacts/*.tar.gz --title "v${VERSION}" --notes "$(awk '/^## \[/{count++} count==1' CHANGELOG.md | tail -n +2)"
# VERSION=$(bun -p 'require("./package.json").version') && cp Formula/aic.rb ../tap/Formula/aic.rb && cd ../tap && git add Formula/aic.rb && git commit -m "aic ${VERSION}" && git push
