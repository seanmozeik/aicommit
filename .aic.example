# Example .aic configuration file
# This file can be used to configure project-specific settings for aic

[project]
# Project-specific settings (optional)
# These can be used to customize aic behavior per project

[presets]
# You can define preset overrides here that apply to this project
# These override the keychain presets if they have the same name

# Example project-specific preset:
# myproject-local = {
#   baseUrl = "http://localhost:1234/v1"
#   model = "my-local-model"
#   contextWindow = 512
# }

[ai]
# AI generation settings (optional)
# max_tokens = 256
# temperature = 0.2
# timeout_seconds = 30